# Copy to .env and fill in.

# Required: Supabase Postgres connection string (the TRANSACTION-mode
# pooler, e.g. port 6543 -- ask()'s one-off queries use this directly).
# scripts/seed_supabase.py and demo/realtime_demo.py derive the session-mode
# variant themselves where they need it (writes, LISTEN/NOTIFY) -- you only
# need to set the transaction-mode one here.
SUPABASE_DB_URL=

# Optional: without an LLM key set, the agent runs entirely on its
# rule-based fallback -- it still works, just without the self-correcting
# LLM path. Set one of these to enable it.

# Option A: Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Option B: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
